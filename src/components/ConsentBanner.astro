---
import { localePath, t, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = t(lang);

const COPY = {
  pt: {
    region: 'Aviso de cookies',
    intro:
      'Ads personalizados e a análise de audiência só entram com o seu ok',
    policy: 'Política de privacidade',
    policyShort: 'política de privacidade',
    customize: 'personalizar',
    necessary: 'só os necessários',
    accept: 'aceitar tudo',
    rejectAll: 'recusar tudo',
    save: 'salvar escolhas',
    change: 'mudar',
    necessaryTitle: 'Necessários',
    necessaryHint: 'Guardam o tema escolhido e esta própria escolha. Sem eles o site não funciona direito',
    alwaysOn: 'sempre ativo',
    analytics: 'Análise',
    analyticsHint: 'Mostra quais posts são mais lidos, de forma agregada. Ajuda a decidir sobre o que escrever',
    analyticsVendor: 'google analytics',
    ads: 'Anúncios',
    adsHint: 'Anúncios personalizados. Recusando, continuam os genéricos',
    adsVendor: 'google adsense',
    toast: { accept: 'tudo aceito. valeu!', necessary: 'só os necessários. de boa', save: 'escolhas salvas' },
  },
  en: {
    region: 'Cookie notice',
    intro:
      'Personalized ads and analytics only come with your ok',
    policy: 'Privacy policy',
    policyShort: 'privacy policy',
    customize: 'customize',
    necessary: 'necessary only',
    accept: 'accept all',
    rejectAll: 'reject all',
    save: 'save choices',
    change: 'change',
    necessaryTitle: 'Necessary',
    necessaryHint: 'They keep the theme you picked and this very choice. Without them the site does not work properly',
    alwaysOn: 'always on',
    analytics: 'Analytics',
    analyticsHint: 'Shows which posts are read the most, in aggregate. Helps decide what to write about',
    analyticsVendor: 'google analytics',
    ads: 'Ads',
    adsHint: 'Personalized ads. If you decline, generic ones still show',
    adsVendor: 'google adsense',
    toast: { accept: 'all accepted. thanks!', necessary: 'necessary only. all good', save: 'choices saved' },
  },
}[lang];

// `switch` is not in Astro's input typings yet
const SWITCH = { switch: '' };
---

<section id="consent" class="consent" popover="manual" aria-label={COPY.region}>
  <div class="text">
    <span class="ps"><span class="sign">$</span> cookies --status</span>
    <p>{COPY.intro} <a href={localePath(lang, '/policies/')}>{COPY.policy}</a></p>
  </div>
  <div class="actions">
    <button type="button" data-action="customize">{COPY.customize}</button>
    <button type="button" data-action="necessary" class="strong">{COPY.necessary}</button>
    <button type="button" data-action="accept" class="primary">{COPY.accept}</button>
  </div>
</section>

<dialog id="consent-prefs" class="consent-prefs" closedby="any" aria-label={ui.cookies}>
  <div class="bar">
    <span class="ps"><span class="sign">$</span> cookies --config</span>
    <button type="button" class="close" commandfor="consent-prefs" command="close" aria-label={ui.close}>×</button>
  </div>
  <form class="prefs">
    <ul>
      <li class="row">
        <span class="copy">
          <strong>{COPY.necessaryTitle}</strong>
          <span>{COPY.necessaryHint}</span>
        </span>
        <span class="always">{COPY.alwaysOn}</span>
      </li>
      <li>
        <label class="row">
          <span class="copy">
            <strong id="consent-analytics-label">{COPY.analytics} <small>{COPY.analyticsVendor}</small></strong>
            <span id="consent-analytics-hint">{COPY.analyticsHint}</span>
          </span>
          <input
            type="checkbox"
            {...SWITCH}
            name="analytics"
            autofocus
            aria-labelledby="consent-analytics-label"
            aria-describedby="consent-analytics-hint"
          />
        </label>
      </li>
      <li>
        <label class="row">
          <span class="copy">
            <strong id="consent-ads-label">{COPY.ads} <small>{COPY.adsVendor}</small></strong>
            <span id="consent-ads-hint">{COPY.adsHint}</span>
          </span>
          <input
            type="checkbox"
            {...SWITCH}
            name="ads"
            aria-labelledby="consent-ads-label"
            aria-describedby="consent-ads-hint"
          />
        </label>
      </li>
    </ul>
    <div class="foot">
      <a href={localePath(lang, '/policies/')}>{COPY.policyShort}</a>
      <div class="actions">
        <button type="submit" value="reject" class="strong">{COPY.rejectAll}</button>
        <button type="submit" value="save" class="primary">{COPY.save}</button>
      </div>
    </div>
  </form>
</dialog>

<p id="consent-toast" class="toast" popover="manual" role="status" data-messages={JSON.stringify(COPY.toast)}>
  <span><span class="tick">✓</span> <span class="msg"></span></span>
  <button type="button" data-action="change">{COPY.change}</button>
</p>

<script>
  import { CONSENT_ID, cmpConfirmed, inCmpRegion, readConsent, saveConsent } from '../lib/consent';

  const TOAST_MS = 6000;

  const banner = document.getElementById(CONSENT_ID);
  const prefs = document.querySelector<HTMLDialogElement>('#consent-prefs');
  const toast = document.querySelector<HTMLElement>('#consent-toast');
  const form = prefs?.querySelector('form');
  const analytics = form?.elements.namedItem('analytics');
  const ads = form?.elements.namedItem('ads');
  const message = toast?.querySelector<HTMLElement>('.msg');

  type Choice = 'accept' | 'necessary' | 'save';

  // The toast copy is server-rendered JSON: anything missing falls back to an empty string
  const readMessages = (raw: string | undefined): Record<Choice, string> => {
    const data: unknown = JSON.parse(raw ?? '{}');
    const pick = (key: Choice): string => {
      const text: unknown = typeof data === 'object' && data !== null ? Reflect.get(data, key) : undefined;
      return typeof text === 'string' ? text : '';
    };
    return { accept: pick('accept'), necessary: pick('necessary'), save: pick('save') };
  };

  if (
    banner && prefs && toast && form && message
    && analytics instanceof HTMLInputElement && ads instanceof HTMLInputElement
    && typeof banner.showPopover === 'function'
  ) {
    const messages = readMessages(toast.dataset.messages);
    let timer: ReturnType<typeof setTimeout> | undefined;

    const armToast = () => {
      clearTimeout(timer);
      timer = setTimeout(() => toast.hidePopover(), TOAST_MS);
    };

    const showToast = (text: string) => {
      message.textContent = text;
      if (!toast.matches(':popover-open')) toast.showPopover();
      armToast();
    };

    // Paused while the reader points at it or focus is inside, so "mudar" never vanishes under them
    toast.addEventListener('pointerenter', () => clearTimeout(timer));
    toast.addEventListener('focusin', () => clearTimeout(timer));
    toast.addEventListener('pointerleave', armToast);
    toast.addEventListener('focusout', armToast);

    const choose = (choice: Choice) => {
      if (choice === 'accept') saveConsent(true, true);
      else if (choice === 'necessary') saveConsent(false, false);
      else saveConsent(analytics.checked, ads.checked);
      if (prefs.open) prefs.close();
      if (banner.matches(':popover-open')) banner.hidePopover();
      showToast(messages[choice]);
    };

    // The dialog stands alone: hide the banner while it is open, bring it back if closed with no choice
    let bannerHidden = false;
    prefs.addEventListener('toggle', (event) => {
      if (event.newState !== 'open' || !banner.matches(':popover-open')) return;
      bannerHidden = true;
      banner.hidePopover();
    });
    prefs.addEventListener('close', () => {
      if (bannerHidden && !readConsent()) banner.showPopover();
      bannerHidden = false;
    });

    const openPrefs = () => {
      toast.hidePopover();
      prefs.showModal();
    };

    // Where Google's CMP runs, the footer button reopens its message instead of ours
    prefs.addEventListener('command', (event) => {
      const fc = window.googlefc;
      if ((event as CommandEvent).command !== 'show-modal' || !cmpConfirmed() || typeof fc?.showRevocationMessage !== 'function') return;
      event.preventDefault();
      fc.showRevocationMessage();
    });

    // Show the stored choice, never pre-ticked switches
    prefs.addEventListener('beforetoggle', (event) => {
      if (event.newState !== 'open') return;
      const stored = readConsent();
      analytics.checked = stored?.analytics ?? false;
      ads.checked = stored?.ads ?? false;
    });

    banner.addEventListener('click', (event) => {
      const target = event.target instanceof Element ? event.target : null;
      const action = target?.closest<HTMLElement>('[data-action]')?.dataset.action;
      if (action === 'customize') openPrefs();
      else if (action === 'accept' || action === 'necessary') choose(action);
    });

    toast.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('[data-action="change"]')) openPrefs();
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const submitter = event.submitter instanceof HTMLButtonElement ? event.submitter.value : 'save';
      choose(submitter === 'reject' ? 'necessary' : 'save');
    });

    if (!readConsent() && !inCmpRegion()) {
      // Marks the first automatic show: it slides only, never fades, so it cannot delay LCP
      banner.dataset.auto = '';
      banner.showPopover();
    }
  }
</script>

<style>
  .consent,
  .consent-prefs,
  .toast {
    box-sizing: border-box;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink);
    font-family: var(--font-body);
  }

  .consent,
  .toast {
    position: fixed;
    inset: auto var(--gutter) 2rem;
    margin: 0;
    inline-size: auto;
    border-radius: var(--radius-lg);
    box-shadow: 0 1.5rem 3.75rem light-dark(rgb(0 0 0 / 15%), rgb(0 0 0 / 50%));
    overflow: visible;
  }

  .consent {
    display: none;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2.5rem;
    align-items: center;
    padding: 1.75rem 2rem;

    &:popover-open {
      display: grid;
    }

    & .text {
      display: flex;
      flex-direction: column;
      gap: 0.625rem;
    }

    & p {
      max-inline-size: 45rem;
      margin: 0;
      color: var(--text);
      font-size: 0.8125rem;
      line-height: 1.55;
    }

    & a {
      color: var(--accent);
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }
  }

  .ps {
    font: 0.8125rem / 1.4 var(--font-code);

    & .sign {
      color: var(--accent);
    }
  }

  .consent .ps {
    color: var(--accent);
  }

  button {
    padding: 0.75rem 1.125rem;
    border: 1px solid var(--line);
    border-radius: 0.625rem;
    background: transparent;
    color: var(--ink);
    font: var(--step--1) / 1.2 var(--font-code);
    cursor: pointer;
    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;

    &:hover {
      border-color: var(--accent);
    }

    &.strong {
      border-color: var(--faint);
    }

    &.primary {
      border-color: var(--accent);
      background: var(--accent);
      color: var(--on-accent);
      font-weight: 600;

      &:hover {
        border-color: var(--ink);
      }
    }
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
  }

  /* Preferences dialog */
  .consent-prefs {
    inline-size: min(40rem, 100% - 2rem);
    max-block-size: calc(100dvh - 2rem);
    margin: auto;
    padding: 0;
    border-radius: 1.125rem;
    box-shadow: 0 1.875rem 5rem light-dark(rgb(0 0 0 / 20%), rgb(0 0 0 / 60%));
    overscroll-behavior: contain;

    &::backdrop {
      background: color-mix(in srgb, var(--bg) 60%, transparent);
    }

    & .bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1.125rem 1.5rem;
      border-block-end: 1px solid var(--line);
      color: var(--muted);
      font: 0.8125rem / 1.4 var(--font-code);
    }

    & .close {
      padding: 0;
      border: 0;
      color: var(--muted);
      font: 1.125rem / 1 var(--font-code);

      &:hover {
        color: var(--ink);
      }
    }

    & ul {
      margin: 0;
      padding: 0.5rem 1.5rem;
      list-style: none;
    }

    & li + li {
      border-block-start: 1px solid var(--line);
    }

    & .row {
      display: flex;
      gap: 1.5rem;
      align-items: center;
      justify-content: space-between;
      padding-block: 1.25rem;
    }

    & label.row {
      cursor: pointer;
    }

    & .copy {
      display: flex;
      flex-direction: column;
      gap: 0.375rem;
      color: var(--soft);
      font-size: 0.8125rem;
      line-height: 1.5;

      & strong {
        color: var(--ink);
        font-size: 1.125rem;
        font-weight: 600;
        line-height: 1.2;

        & small {
          color: var(--muted);
          font: 400 0.75rem var(--font-code);
        }
      }
    }

    & .always {
      flex: none;
      color: var(--muted);
      font: 0.8125rem / 1.2 var(--font-code);
    }

    & .foot {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem 1.5rem;
      align-items: center;
      justify-content: space-between;
      padding: 1.125rem 1.5rem;
      border-block-start: 1px solid var(--line);

      & a {
        color: var(--accent);
        font: 0.8125rem / 1.2 var(--font-code);
        text-decoration: none;

        &:hover {
          color: var(--ink);
        }
      }
    }
  }

  /* Native switch, drawn as a 52x30 pill; still a plain checkbox where `switch` is unsupported */
  input[switch] {
    position: relative;
    flex: none;
    appearance: none;
    inline-size: 3.25rem;
    block-size: 1.875rem;
    margin: 0;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg);
    cursor: pointer;
    transition:
      background 0.2s ease,
      border-color 0.2s ease;

    &::before {
      content: '';
      position: absolute;
      inset-block: 0.1875rem;
      inset-inline-start: 0.1875rem;
      inline-size: 1.375rem;
      border-radius: 50%;
      background: var(--faint);
      transition:
        translate 0.2s var(--ease),
        background 0.2s ease;
    }

    &:checked {
      border-color: var(--accent-deep);
      background: var(--accent-deep);

      &::before {
        background: var(--accent);
        translate: 1.375rem 0;
      }
    }
  }

  /* Status toast */
  .toast {
    display: none;
    inset-inline-end: auto;
    align-items: center;
    gap: 1rem;
    padding: 0.875rem 1.125rem;
    border-radius: 0.75rem;
    font: var(--step--1) / 1.4 var(--font-code);

    &:popover-open {
      display: flex;
    }

    & .tick {
      color: var(--accent);
    }

    & button {
      padding: 0;
      border: 0;
      color: var(--muted);
      text-decoration: underline;
      text-underline-offset: 3px;
    }
  }

  :where(.consent, .consent-prefs, .toast) :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* Below this the three actions no longer fit beside the text, so they drop under it */
  @media (width < 64rem) {
    .consent {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25rem;
      inset-block-end: 1rem;
      padding: 1.25rem;
      max-block-size: calc(100dvh - 2rem);
      overflow: auto;
    }
  }

  @media (width < 48rem) {
    .consent .actions {
      flex-direction: column;
    }

    button {
      min-block-size: 2.75rem;
    }

    .toast {
      inset-block-end: 1rem;
    }

    .consent-prefs .row {
      gap: 1rem;
    }

    .consent-prefs .foot .actions {
      inline-size: 100%;
    }

    .consent-prefs .foot .actions button {
      flex: 1;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .consent,
    .toast {
      transition:
        opacity 0.35s var(--ease),
        translate 0.35s var(--ease),
        display 0.35s allow-discrete,
        overlay 0.35s allow-discrete;

      &:not(:popover-open) {
        opacity: 0;
        translate: 0 1rem;
      }

      @starting-style {
        &:popover-open:not([data-auto]) {
          opacity: 0;
          translate: 0 1rem;
        }

        &[data-auto]:popover-open {
          translate: 0 1rem;
        }
      }
    }

    .consent-prefs {
      opacity: 0;
      translate: 0 1rem;
      transition:
        opacity 0.25s var(--ease),
        translate 0.25s var(--ease),
        display 0.25s allow-discrete,
        overlay 0.25s allow-discrete;

      &[open] {
        opacity: 1;
        translate: 0 0;
      }

      &::backdrop {
        opacity: 0;
        transition:
          opacity 0.25s var(--ease),
          display 0.25s allow-discrete,
          overlay 0.25s allow-discrete;
      }

      &[open]::backdrop {
        opacity: 1;
      }

      @starting-style {
        &[open] {
          opacity: 0;
          translate: 0 1rem;
        }

        &[open]::backdrop {
          opacity: 0;
        }
      }
    }
  }
</style>
