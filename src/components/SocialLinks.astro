---
import { localePath, t, type Lang } from '../lib/i18n';
import { SOCIAL_PROFILES } from '../lib/social';
import SocialIcon from './SocialIcon.astro';

interface Props {
  lang: Lang;
  /** labelled: icon + text at text size, X leads with its handle. compact: icons only (footer) */
  variant: 'labelled' | 'compact';
}

const { lang, variant } = Astro.props;
const ui = t(lang);
const labelled = variant === 'labelled';

const links = [
  ...SOCIAL_PROFILES.map(({ id, label, handle, href }) => ({ id, label, handle, href, me: true })),
  ...(labelled ? [] : [{ id: 'rss' as const, label: 'RSS', handle: '', href: localePath(lang, '/feed.xml'), me: false }]),
];
---

<ul class:list={['social', `social-${variant}`]} aria-label={ui.contact}>
  {
    links.map(({ id, label, handle, href, me }) => (
      <li>
        <a href={href} aria-label={labelled ? undefined : label} rel={me ? 'me' : undefined}>
          <SocialIcon name={id} size={20} />
          {labelled &&
            (id === 'x' ? (
              <span class="label">
                <span class="visually-hidden">{label} </span>
                {handle}
              </span>
            ) : (
              <span class="label">{label}</span>
            ))}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .social {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-ui);
  }

  a {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem;
    text-decoration: none;
  }

  /* Icons sit at text size: the tap target comes from the padding, not from visual bulk */
  .social-labelled {
    gap: 0 var(--space-4);
    font-size: var(--step-0);
    font-stretch: 110%;
    font-weight: 650;

    & a {
      gap: 0.4em;
    }

    & a :global(svg) {
      flex: none;
      inline-size: 1.1em;
      block-size: 1.1em;
    }

    & .label {
      text-decoration: underline;
      text-decoration-thickness: 0.07em;
      text-underline-offset: 0.2em;
    }

    & a:hover .label {
      text-decoration-thickness: 0.14em;
    }
  }

  .social-compact {
    gap: var(--space-1);

    /* Optical alignment: the first glyph, not its tap target, lines up with the text above */
    margin-inline-start: -0.75rem;

    & a {
      justify-content: center;
      min-inline-size: 2.75rem;
      border-radius: var(--radius);
      color: var(--muted);

      &:hover {
        background: var(--wash);
        color: var(--ink);
      }
    }
  }
</style>
