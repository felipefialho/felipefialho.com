---
import type { MarkdownHeading } from 'astro';
import { t, type Lang } from '../lib/i18n';

interface Props {
  headings: MarkdownHeading[];
  lang: Lang;
  /** inline: collapsible, below 60rem. sidebar: sticky in the margin column, from 60rem */
  variant: 'inline' | 'sidebar';
}

const { headings, lang, variant } = Astro.props;
const label = t(lang).toc;
---

{
  variant === 'inline' ? (
    <details class="toc toc-inline" data-pagefind-ignore>
      <summary>{label}</summary>
      <ol>
        {headings.map(({ slug, text }) => (
          <li>
            <a href={`#${slug}`}>{text}</a>
          </li>
        ))}
      </ol>
    </details>
  ) : (
    <nav class="toc toc-sidebar aside" aria-label={label} data-pagefind-ignore>
      {/* Scroll-spy (Chromium for now). Inline: lightningcss cannot parse :target-current yet */}
      <style is:inline>
        .toc-sidebar a:target-current {
          --toc-current: var(--ink);
          --toc-mark: underline 0.12em var(--link);
        }
      </style>
      <p>{label}</p>
      <ol>
        {headings.map(({ slug, text }) => (
          <li>
            <a href={`#${slug}`}>{text}</a>
          </li>
        ))}
      </ol>
    </nav>
  )
}

<style>
  .toc {
    font-family: var(--font-ui);
    font-size: var(--step--1);
    line-height: 1.35;

    & ol {
      display: grid;
      margin: var(--space-3) 0 0;
      padding: 0;
      list-style: none;
    }

    & a {
      display: block;
      padding-block: 0.35rem;
      text-decoration: none;

      &:hover {
        text-decoration: underline;
      }
    }
  }

  .toc-inline {
    margin-block-end: var(--space-5);
    padding: var(--space-2) var(--space-4) var(--space-3);
    border-inline-start: 4px solid var(--link);
    background: var(--wash);

    & summary {
      display: flex;
      align-items: center;
      min-block-size: 2.75rem;
      font-stretch: 112%;
      font-weight: 700;
      cursor: pointer;
    }

    & ol {
      margin-block-start: 0;
    }

    @media (width >= 60rem) {
      display: none;
    }
  }

  .toc-sidebar {
    display: none;
    position: sticky;
    inset-block-start: var(--space-5);
    align-self: start;
    max-block-size: calc(100dvh - 2 * var(--space-5));
    overflow-y: auto;

    & p {
      margin: 0;
      color: var(--ink);
      font-stretch: 112%;
      font-weight: 700;
    }

    & ol {
      scroll-target-group: auto;
    }

    /* The current section turns to ink with a marked underline: you are here */
    & a {
      color: var(--toc-current, var(--link));
      text-decoration: var(--toc-mark, none);
      text-underline-offset: 0.25em;
    }

    @media (width >= 60rem) {
      display: block;
    }
  }
</style>
