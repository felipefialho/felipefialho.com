---
import { END_SLOT, SIDEBAR_SLOT } from '../lib/ads';
import { t, type Lang } from '../lib/i18n';

interface Props {
  kind: 'end' | 'sidebar';
  lang: Lang;
}

const { kind, lang } = Astro.props;
const slot = kind === 'end' ? END_SLOT : SIDEBAR_SLOT;
---

{
  slot && (
    <aside
      class:list={['ad', `ad-${kind}`]}
      data-ad-slot={slot}
      data-ad-format="auto"
      data-pagefind-ignore
      data-full-width-responsive={kind === 'end' ? 'true' : undefined}
      aria-label={t(lang).ad}
    ></aside>
  )
}
