---
import { formatShortDate, isoDate, t, type Lang } from '../lib/i18n';
import { getAdjacent, getRelated, postPath, type Post } from '../lib/posts';

interface Props {
  lang: Lang;
  post: Post;
  posts: Post[];
}

const { lang, post, posts } = Astro.props;
const ui = t(lang);
const { older, newer } = getAdjacent(posts, post.id);
const related = getRelated(posts, post);
const pix = 'hi@felipefialho.com';

// filePath is relative to the repo root; fall back to the folder if the loader omits it
const repoUrl = 'https://github.com/felipefialho/felipefialho.com';
const sourceDir = lang === 'pt' ? 'posts' : 'posts-en';
const editUrl = post.filePath ? `${repoUrl}/blob/main/${post.filePath}` : `${repoUrl}/tree/main/content/${sourceDir}`;
---

<footer class="post-footer">
  <section class="support" aria-labelledby="support-title">
    <h2 id="support-title">{ui.supportPost}</h2>
    <div class="support-actions">
      <p class="pix">
        <span>{ui.pixLabel}</span>
        <code>{pix}</code>
        <button type="button" data-copy={pix} data-copied={ui.copied} data-failed={ui.copyFailed}>{ui.copy}</button>
        <span class="visually-hidden" role="status" data-copy-status></span>
      </p>
      <a class="sponsor" href="https://github.com/sponsors/felipefialho" data-track="sponsor_click">{ui.sponsors}</a>
    </div>
    <p class="fix">{ui.fix} <a href={editUrl}>{ui.fixLink}</a>.</p>
  </section>

  {
    (older || newer) && (
      <nav class="adjacent" aria-label={ui.adjacentPosts}>
        {older && (
          <a href={postPath(lang, older.id)} rel="prev">
            <span>{ui.previous}</span>
            <strong>{older.data.title}</strong>
          </a>
        )}
        {newer && (
          <a href={postPath(lang, newer.id)} rel="next" class="newer">
            <span>{ui.next}</span>
            <strong>{newer.data.title}</strong>
          </a>
        )}
      </nav>
    )
  }

  {
    related.length > 0 && (
      <section class="related" aria-labelledby="related-title">
        <h2 id="related-title" class="section-title">
          {ui.related}
        </h2>
        <ol class="rows">
          {related.map((item) => (
            <li>
              <a class="title-link" href={postPath(lang, item.id)}>
                {item.data.title}
              </a>
              <time datetime={isoDate(item.data.date)}>{formatShortDate(item.data.date, lang)}</time>
            </li>
          ))}
        </ol>
      </section>
    )
  }
</footer>

<script>
  const RESET_MS = 2000;

  document.querySelectorAll<HTMLButtonElement>('button[data-copy]').forEach((button) => {
    button.addEventListener('click', async () => {
      const { copy = '', copied = '', failed = '' } = button.dataset;
      const status = button.parentElement?.querySelector<HTMLElement>('[data-copy-status]');
      const label = button.textContent;
      const announce = (message: string) => {
        if (status) status.textContent = message;
        setTimeout(() => {
          if (status) status.textContent = '';
        }, RESET_MS);
      };
      try {
        await navigator.clipboard.writeText(copy);
        button.textContent = copied;
        setTimeout(() => (button.textContent = label), RESET_MS);
        announce(copied);
        window.track?.('pix_copy');
      } catch {
        // Clipboard denied: the key stays visible to copy by hand
        announce(failed);
      }
    });
  });

  document.querySelectorAll<HTMLAnchorElement>('a[data-track]').forEach((link) => {
    link.addEventListener('click', () => window.track?.(link.dataset.track ?? ''));
  });
</script>

<style>
  .post-footer {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    max-inline-size: var(--measure);
    margin-block-start: var(--space-6);

    @media (width >= 60rem) {
      margin-inline-start: calc(var(--aside) + var(--aside-gap));
    }
  }

  .support {
    padding: var(--space-4);
    border-inline-start: 4px solid var(--link);
    background: var(--wash);

    & h2 {
      margin: 0 0 var(--space-3);
      font-size: var(--step-1);
    }
  }

  .support-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
    font-family: var(--font-ui);
    font-size: var(--step--1);
  }

  .pix {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin: 0;

    & code {
      padding: 0.2em 0.4em;
      border-radius: var(--radius);
      background: var(--paper);
    }

    & button {
      min-block-size: 2.75rem;
      padding: 0 var(--space-3);
      border: 1px solid var(--link);
      border-radius: var(--radius);
      background: var(--paper);
      color: var(--link);
      font-weight: 650;
      cursor: pointer;

      &:hover {
        background: var(--link);
        color: var(--on-link);
      }
    }
  }

  .sponsor {
    font-weight: 650;
  }

  .fix {
    margin: var(--space-3) 0 0;
    color: var(--muted);
    font-size: var(--step--1);
  }

  .adjacent {
    display: grid;
    gap: var(--space-4) var(--space-5);
    font-family: var(--font-ui);

    @media (width >= 40rem) {
      grid-template-columns: 1fr 1fr;
    }

    & a {
      display: grid;
      gap: var(--space-1);
      text-decoration: none;

      &:hover strong {
        text-decoration-thickness: 0.12em;
      }
    }

    & strong {
      font-stretch: 106%;
      font-weight: 650;
      line-height: 1.3;
      text-decoration: underline;
      text-decoration-thickness: 0.05em;
      text-underline-offset: 0.18em;
    }

    & span {
      color: var(--muted);
      font-size: var(--step--1);
    }

    & .newer {
      grid-column: -2;
      text-align: end;
    }
  }

  .related .section-title {
    margin-block-end: var(--space-3);
  }
</style>
