---
import { Image } from 'astro:assets';
import avatar from '../assets/images/felipe-fialho.jpg';
import { HTML_LANG, localePath, t, type Lang } from '../lib/i18n';
import { SOCIAL_PROFILES } from '../lib/social';
import SocialIcon from './SocialIcon.astro';

interface Props {
  lang: Lang;
  alternate?: string;
  /** Continues the wordmark path, e.g. "blog/my-post" renders ~/felipefialho/blog/my-post */
  pathSuffix?: string;
  /** Reading time of a post: enables the scroll progress bar and the "34% read" text */
  readingMinutes?: number;
}

const { lang, alternate, pathSuffix, readingMinutes } = Astro.props;
const ui = t(lang);
const otherLang: Lang = lang === 'pt' ? 'en' : 'pt';
const langHref = alternate ?? localePath(otherLang, '/');
const withSlash = (value: string) => (value.endsWith('/') ? value : `${value}/`);
const path = withSlash(Astro.url.pathname);

// "page" on the exact route, "true" for pages inside the section (e.g. a post under /blog/)
const currentState = (href: string) => {
  if (path === href) return 'page';
  return path.startsWith(href) ? 'true' : undefined;
};

const nav = [
  { href: localePath(lang, '/blog/'), label: ui.navBlog },
  { href: localePath(lang, '/lab/'), label: ui.navLab },
  { href: localePath(lang, '/hi/'), label: ui.navAbout },
];

const socials = SOCIAL_PROFILES.filter(({ id }) => id !== 'youtube').sort(
  (a, b) => ['github', 'linkedin', 'x'].indexOf(a.id) - ['github', 'linkedin', 'x'].indexOf(b.id),
);
const suffix = pathSuffix?.replace(/^\/+/, '');
// Strings for the CSS-generated progress text
const readStrings = `--mins: ${readingMinutes}; --s-done: '${ui.readDone}'; --s-before: '${ui.readLeftBefore}'; --s-min: '${ui.minShort}'; --s-after: '${ui.readLeftAfter}'`;
---

{readingMinutes && <div class="progress" aria-hidden="true"></div>}
<header class:list={['site-header', { 'is-reading': readingMinutes }]}>
  <div class="bar page">
    <a class="wordmark" href={localePath(lang, '/')}>
      <Image
        class="avatar"
        src={avatar}
        alt=""
        width={32}
        height={32}
        densities={[1, 2]}
        fit="cover"
        loading="eager"
      />
      <span class="path">
        <span class="accent">~/</span>felipefialho{suffix && <span class="suffix">/{suffix}</span>}
      </span>
    </a>
    {
      readingMinutes && (
        <p class="read" style={readStrings}>
          <span class="read-static">{ui.readingTime(readingMinutes)}</span>
          <span class="read-live" aria-hidden="true" data-testid="reading-progress"></span>
        </p>
      )
    }
    <nav class="site-nav" aria-label={ui.mainNav}>
      <ul>
        {
          nav.map(({ href, label }) => (
            <li>
              <a href={href} aria-current={currentState(href)}>
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="tools">
      <button
        class="search"
        type="button"
        commandfor="search"
        command="show-modal"
        aria-keyshortcuts="Control+K Meta+K"
      >
        <svg class="search-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
          <circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2"></circle>
          <path d="m15.5 15.5 5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
        </svg>
        <span class="search-text">{ui.searchShort}</span>
        <kbd class="hint" aria-hidden="true" data-search-hint>⌘K</kbd>
      </button>
      <span class="divider" aria-hidden="true"></span>
      <ul class="socials">
        {
          socials.map(({ id, label, href }) => (
            <li>
              <a href={href} aria-label={label} rel="me">
                <SocialIcon name={id} size={id === 'x' ? 16 : 18} />
              </a>
            </li>
          ))
        }
      </ul>
      <a class="lang" href={langHref} hreflang={HTML_LANG[otherLang]} lang={HTML_LANG[otherLang]} aria-label={`${otherLang}: ${ui.switchLang}`}>
        {otherLang}
      </a>
      <button class="theme" type="button" data-theme-toggle data-label-light={ui.themeToLight} data-label-dark={ui.themeToDark} aria-label={ui.themeToLight}>
        <svg class="moon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" fill="none" stroke="currentColor" stroke-width="2"></path>
        </svg>
        <svg class="sun" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
          <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"></circle>
          <path
            d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          ></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const themeColor = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
  // Dark is the default: only an explicit "light" changes anything
  const isLight = () => root.dataset.theme === 'light';

  const syncTheme = () => {
    if (!toggle) return;
    toggle.setAttribute('aria-label', (isLight() ? toggle.dataset.labelDark : toggle.dataset.labelLight) ?? '');
    themeColor?.setAttribute('content', isLight() ? '#fafafa' : '#0f0f0f');
  };

  syncTheme();

  toggle?.addEventListener('click', () => {
    const next = isLight() ? 'dark' : 'light';
    root.dataset.theme = next;
    syncTheme();
    try {
      localStorage.setItem('theme', next);
    } catch {
      // Private mode: the choice lasts for this page only
    }
    window.track?.('theme_change', { theme: next });
  });

  // Ctrl+K (Cmd+K on a Mac) opens the search dialog
  const isMac = /mac|iphone|ipad/i.test(navigator.userAgent);
  const hint = document.querySelector<HTMLElement>('[data-search-hint]');
  if (hint && !isMac) hint.textContent = 'Ctrl K';

  addEventListener('keydown', (event) => {
    if (event.key.toLowerCase() !== 'k' || !(isMac ? event.metaKey : event.ctrlKey) || event.altKey || event.shiftKey) return;
    const dialog = document.querySelector<HTMLDialogElement>('#search');
    if (!dialog) return;
    event.preventDefault();
    if (!dialog.open) dialog.showModal();
  });

  // A hello for whoever opens DevTools
  const hello = document.documentElement.lang === 'en'
    ? 'Hi, dev! Curious about the code? It is open source:'
    : 'Opa, dev! Curioso com o código? É open source:';
  console.log(
    `%cfelipefialho.com%c\n${hello} https://github.com/felipefialho/felipefialho.com`,
    `color:${isLight() ? '#00778a' : '#a1ecf7'};font:600 1.5em ui-monospace,monospace`,
    'font:1em system-ui,sans-serif',
  );

  // Invoker commands fallback for browsers without `command` support
  if (!('command' in HTMLButtonElement.prototype)) {
    document.querySelectorAll<HTMLButtonElement>('button[commandfor][command]').forEach((button) => {
      button.addEventListener('click', () => {
        const target = document.getElementById(button.getAttribute('commandfor') ?? '');
        if (!(target instanceof HTMLDialogElement)) return;
        const command = button.getAttribute('command');
        if (command === 'show-modal') target.showModal();
        if (command === 'close') target.close();
      });
    });
  }
</script>

<style>
  /* Anchor jumps land below the pinned reading header */
  @media (width >= 48rem) {
    :global(:root:has(.is-reading)) {
      scroll-padding-block-start: 6rem;
    }
  }

  @property --read {
    syntax: '<integer>';
    inherits: true;
    initial-value: 0;
  }

  @property --left {
    syntax: '<integer>';
    inherits: true;
    initial-value: 0;
  }

  .site-header {
    border-block-end: 1px solid var(--line);
    font-family: var(--font-code);
    font-size: var(--step--1);
  }

  /* Posts get the reading header from the board: the path, the progress and the theme toggle, pinned in view */
  .is-reading {
    /* Phones keep the two-row header in the flow: pinned it would cover a third of the screen */
    @media (width >= 48rem) {
      position: sticky;
      inset-block-start: 0;
      z-index: 10;
      background: var(--bg);

      & .avatar,
      & .site-nav,
      & .tools > :not(.theme) {
        display: none;
      }
    }

    & .read {
      margin-inline-start: auto;
    }
  }

  /* Phones: wordmark, search and theme on the first row; nav and language on the second */
  .bar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 0 var(--space-2);
    padding-block: var(--space-2);

    @media (width >= 48rem) {
      display: flex;
      gap: 2rem;
      padding-block: 1.5rem;
    }
  }

  .wordmark {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-inline-size: 0;
    min-block-size: 2.75rem;
    color: var(--ink);
    grid-column: 1;
    grid-row: 1;

    &:hover {
      text-decoration: none;
    }

    /* Only in the flex row: an auto margin on a grid item would size it to its content and overflow */
    @media (width >= 48rem) {
      min-block-size: 0;
      margin-inline-end: auto;
    }

    & .avatar {
      flex: none;
      inline-size: 2rem;
      block-size: 2rem;
      border-radius: 50%;
      object-fit: cover;
      filter: grayscale(1);
    }
  }

  .path {
    min-inline-size: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .accent {
    color: var(--accent);
  }

  .suffix {
    color: var(--muted);
  }

  .site-nav {
    grid-column: 1 / 3;
    grid-row: 2;

    & ul {
      display: flex;
      gap: var(--space-4);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    & a {
      display: inline-flex;
      align-items: center;
      min-block-size: 2.75rem;
      color: var(--muted);

      &:hover {
        color: var(--ink);
        text-decoration: none;
      }

      &[aria-current] {
        color: var(--ink);
      }
    }

    @media (width >= 48rem) {
      & ul {
        gap: 2rem;
      }

      & a {
        min-block-size: 0;
      }
    }
  }

  /* On phones the tools dissolve into the grid so search and theme sit on row one */
  .tools {
    display: contents;

    @media (width >= 48rem) {
      display: flex;
      align-items: center;
      gap: 2rem;
    }
  }

  .search {
    display: flex;
    grid-column: 2;
    grid-row: 1;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    min-inline-size: 2.75rem;
    min-block-size: 2.75rem;
    padding: 0.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--muted);
    font: inherit;
    cursor: pointer;

    &:hover {
      color: var(--ink);
    }

    @media (width >= 48rem) {
      min-inline-size: 0;
      min-block-size: 0;
      padding: 0.5rem 0.75rem;
    }
  }

  /* The word names the button, so below the breakpoint it is hidden visually but kept for assistive tech */
  .search-text {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;

    @media (width >= 48rem) {
      position: static;
      inline-size: auto;
      block-size: auto;
      overflow: visible;
      clip-path: none;
    }
  }

  .hint {
    display: none;
    padding: 1px 6px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    font: inherit;
    font-size: var(--step--2);

    @media (width >= 48rem) {
      display: inline;
    }
  }

  .search-icon {
    @media (width >= 48rem) {
      display: none;
    }
  }

  .divider,
  .socials {
    display: none;

    @media (width >= 48rem) {
      display: flex;
    }
  }

  .divider {
    inline-size: 1px;
    block-size: 1.5rem;
    background: var(--line);
  }

  .socials {
    gap: 0.375rem;
    margin: 0;
    padding: 0;
    list-style: none;

    & a {
      display: grid;
      place-items: center;
      inline-size: 2.25rem;
      block-size: 2.25rem;
      color: var(--muted);

      &:hover {
        color: var(--accent);
      }
    }
  }

  .lang {
    display: inline-flex;
    grid-column: 3;
    grid-row: 2;
    align-items: center;
    justify-content: end;
    min-block-size: 2.75rem;
    color: var(--muted);

    &:hover {
      color: var(--ink);
      text-decoration: none;
    }

    @media (width >= 48rem) {
      min-block-size: 0;
    }
  }

  .theme {
    display: grid;
    grid-column: 3;
    grid-row: 1;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: transparent;
    color: var(--accent);
    cursor: pointer;

    &:hover {
      background: var(--surface);
    }

    @media (width >= 48rem) {
      inline-size: 2.25rem;
      block-size: 2.25rem;
    }

    & .sun {
      display: none;
    }

    :global(:root[data-theme='light']) & {
      & .moon {
        display: none;
      }

      & .sun {
        display: block;
      }
    }
  }

  /* Post pages: reading progress. Scroll-driven, so it needs no JS; older browsers show the time only */
  .progress {
    display: none;
  }

  .read {
    display: none;
    margin: 0;
    color: var(--muted);
    white-space: nowrap;

    @media (width >= 48rem) {
      display: block;
    }
  }

  .read-live {
    display: none;
  }

  @supports (animation-timeline: scroll()) {
    .progress {
      position: fixed;
      inset: 0 0 auto;
      z-index: 20;
      display: block;
      block-size: 3px;
      background: var(--surface);

      &::after {
        content: '';
        display: block;
        block-size: 100%;
        background: var(--accent);
        transform: scaleX(0);
        transform-origin: left;
        animation: grow linear both;
      }
    }

    .read-static {
      position: absolute;
      inline-size: 1px;
      block-size: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }

    .read-live {
      display: inline;

      /* Registered as an integer, so the minutes left round to whole numbers */
      --left: calc(var(--mins) * (100 - var(--read)) / 100);

      counter-reset: pct var(--read) left var(--left);
      animation: read-progress linear both;

      &::before {
        content: counter(pct) '% ' var(--s-done) ' · ' var(--s-before) counter(left) ' ' var(--s-min) var(--s-after);
      }
    }
  }

  /*
   * A rule of its own: the minifier would otherwise fold the timeline into the `animation`
   * shorthand, which Chrome rejects, dropping the whole declaration.
   */
  @supports (animation-timeline: scroll()) {
    .progress::after,
    .read-live {
      animation-timeline: scroll(root);
    }
  }

  @keyframes grow {
    to {
      transform: scaleX(1);
    }
  }

  @keyframes read-progress {
    from {
      --read: 0;
    }

    to {
      --read: 100;
    }
  }
</style>
