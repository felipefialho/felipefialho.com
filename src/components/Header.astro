---
import { HTML_LANG, localePath, t, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  alternate?: string;
}

const { lang, alternate } = Astro.props;
const ui = t(lang);
const otherLang: Lang = lang === 'pt' ? 'en' : 'pt';
const langHref = alternate ?? localePath(otherLang, '/');
const withSlash = (value: string) => (value.endsWith('/') ? value : `${value}/`);
const path = withSlash(Astro.url.pathname);

// "page" on the exact route, "true" for pages inside the section (e.g. a post under /blog/)
const currentState = (href: string) => {
  if (path === href) return 'page';
  return path.startsWith(href) ? 'true' : undefined;
};

const nav = [
  { href: localePath(lang, '/blog/'), label: ui.blog },
  { href: localePath(lang, '/lab/'), label: ui.lab },
  { href: localePath(lang, '/hi/'), label: ui.about },
];
---

<header class="site-header band">
  <div class="bar page">
    <a class="wordmark" href={localePath(lang, '/')}>felipefialho.com</a>
    <nav class="site-nav" aria-label={ui.mainNav}>
      <ul>
        {
          nav.map(({ href, label }) => (
            <li>
              <a href={href} aria-current={currentState(href)}>
                {label}
              </a>
            </li>
          ))
        }
        <li>
          <a href={langHref} hreflang={HTML_LANG[otherLang]} lang={HTML_LANG[otherLang]}>{ui.switchLang}</a>
        </li>
      </ul>
    </nav>
    <div class="tools">
      <button class="icon-button" type="button" commandfor="search" command="show-modal" aria-label={ui.search}>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2"></circle>
          <path d="m15.5 15.5 5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
        </svg>
      </button>
      <button class="icon-button" type="button" data-theme-toggle aria-pressed="false" aria-label={ui.theme}>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="2"></circle>
          <path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const currentTheme = () => root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
  const syncPressed = () => toggle?.setAttribute('aria-pressed', String(currentTheme() === 'dark'));

  syncPressed();

  toggle?.addEventListener('click', () => {
    const next = currentTheme() === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    syncPressed();
    try {
      localStorage.setItem('theme', next);
    } catch {
      // Private mode: the choice lasts for this page only
    }
    window.track?.('theme_change', { theme: next });
  });

  // A hello for whoever opens DevTools
  const hello = document.documentElement.lang === 'en'
    ? 'Hi, dev! Curious about the code? It is open source:'
    : 'Opa, dev! Curioso com o código? É open source:';
  const hint = document.documentElement.lang === 'en' ? 'Psst: try ↑↑↓↓←→←→BA on a 404.' : 'Psst: tenta ↑↑↓↓←→←→BA numa página 404.';
  console.log(
    `%cfelipefialho.com%c\n${hello} https://github.com/felipefialho/felipefialho.com\n${hint}`,
    `color:${matchMedia('(prefers-color-scheme: dark)').matches ? '#a3a8ff' : '#00e'};font:800 1.5em system-ui,sans-serif;text-decoration:underline`,
    'font:1em system-ui,sans-serif',
  );

  // Invoker commands fallback for browsers without `command` support
  if (!('command' in HTMLButtonElement.prototype)) {
    document.querySelectorAll<HTMLButtonElement>('button[commandfor][command]').forEach((button) => {
      button.addEventListener('click', () => {
        const target = document.getElementById(button.getAttribute('commandfor') ?? '');
        if (!(target instanceof HTMLDialogElement)) return;
        const command = button.getAttribute('command');
        if (command === 'show-modal') target.showModal();
        if (command === 'close') target.close();
      });
    });
  }
</script>

<style>
  .bar {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'wordmark tools'
      'nav nav';
    align-items: center;
    gap: 0 var(--space-4);
    padding-block: var(--space-2);
    font-family: var(--font-ui);
    font-size: var(--step--1);
    font-stretch: 112%;
    font-weight: 600;

    @media (width >= 48rem) {
      grid-template-columns: auto 1fr auto;
      grid-template-areas: 'wordmark nav tools';
      padding-block: var(--space-3);
    }
  }

  .wordmark {
    grid-area: wordmark;
    justify-self: start;
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem;
    font-size: var(--step-0);
    font-stretch: 125%;
    font-weight: 800;
    letter-spacing: -0.01em;
    text-decoration: none;

    &:hover {
      text-decoration: underline;
    }
  }

  .site-nav {
    grid-area: nav;

    & ul {
      display: flex;
      flex-wrap: wrap;
      gap: 0 var(--space-4);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    & a {
      display: inline-flex;
      align-items: center;
      min-block-size: 2.75rem;
      text-decoration: none;

      &:hover,
      &[aria-current] {
        text-decoration: underline;
      }
    }

    @media (width >= 48rem) {
      justify-self: end;
    }
  }

  .tools {
    grid-area: tools;
    display: flex;
    align-items: center;
    margin-inline-end: calc(-1 * var(--space-2));
  }

  .icon-button {
    display: inline-grid;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    padding: 0;
    border: 0;
    border-radius: var(--radius);
    background: none;
    color: var(--band-link);
    cursor: pointer;

    &:hover {
      background: color-mix(in srgb, currentcolor 16%, transparent);
    }
  }
</style>
