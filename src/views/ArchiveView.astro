---
import Base from '../layouts/Base.astro';
import { formatMonth, isoDate, localePath, t, type Lang } from '../lib/i18n';
import { getPosts, groupByYear, postPath, tagLabel, tagPath, type Post } from '../lib/posts';
import { collectionPageJsonLd } from '../lib/seo';

interface Props {
  lang: Lang;
  /** Defaults to every post in the language */
  posts?: Post[];
  /** Renders a tag archive instead of the full one */
  tag?: string;
  /** Same page in the other language, when it exists */
  alternate?: string;
}

const { lang, tag, alternate } = Astro.props;
const ui = t(lang);
const { posts = await getPosts(lang) } = Astro.props;
const label = tag ? tagLabel(tag) : '';
const title = tag ? ui.tagTitle(label) : ui.blog;
const lede = tag ? ui.tagLede(posts.length, label) : ui.archiveLede(posts.length);
const description = tag
  ? ui.tagDescription(posts.length, label, posts.slice(0, 2).map((post) => post.data.title))
  : ui.archiveDescription;
const pagePath = tag ? tagPath(lang, tag) : localePath(lang, '/blog/');
const jsonLd = collectionPageJsonLd({ lang, path: pagePath, title, description, crumb: tag ? title : undefined });
// The English archive is a subset: point readers to the full Portuguese one
const showOtherLang = lang === 'en' && !tag;
---

<Base lang={lang} title={title} description={description} alternate={alternate} jsonLd={jsonLd}>
  <h1 class="page-title">{title}</h1>
  <p class="lede reading">{lede}</p>
  {
    showOtherLang && (
      <p>
        <a class="text-link" href="/blog/" hreflang="pt-BR" lang="pt-BR">
          {ui.morePostsOtherLang}
        </a>
      </p>
    )
  }
  {
    groupByYear(posts).map(([year, items]) => (
      <section class="year" aria-labelledby={`year-${year}`}>
        <h2 id={`year-${year}`} class="year-title">
          {year}
        </h2>
        <ol class="rows">
          {items.map((post) => (
            <li class="row">
              <time datetime={isoDate(post.data.date)}>{formatMonth(post.data.date, lang)}</time>
              <a href={postPath(lang, post.id)} style={`view-transition-name: post-${post.id}`}>
                {post.data.title}
              </a>
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</Base>

<style>
  .year {
    display: grid;
    gap: var(--space-3);
    margin-block-start: var(--space-5);

    @media (width >= 64rem) {
      grid-template-columns: minmax(12rem, 1fr) 3fr;
      align-items: start;
    }
  }

  /* The one bold moment: 13 years, set wide */
  .year-title {
    position: sticky;
    inset-block-start: 0;
    z-index: 1;
    margin: 0;
    padding-block: var(--space-2);
    background: var(--paper);
    color: var(--ink);
    font-size: var(--step-5);
    font-stretch: 125%;
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.03em;

    @media (width >= 64rem) {
      inset-block-start: var(--space-4);
      background: none;
    }
  }

  .rows {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
    max-inline-size: var(--measure);

    @media (width >= 64rem) {
      padding-block-start: var(--space-3);
    }
  }

  .row {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: var(--space-3);
    align-items: baseline;

    & time {
      color: var(--muted);
      font-family: var(--font-ui);
      font-size: var(--step--1);
    }

    & a {
      font-family: var(--font-ui);
      font-size: var(--step-1);
      font-stretch: 105%;
      font-weight: 600;
      line-height: 1.25;
      text-decoration-color: color-mix(in srgb, currentcolor 35%, transparent);
    }
  }
</style>
