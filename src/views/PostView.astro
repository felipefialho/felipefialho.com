---
import { render } from 'astro:content';
import AdSlot from '../components/AdSlot.astro';
import AdsLoader from '../components/AdsLoader.astro';
import Base from '../layouts/Base.astro';
import PostFooter from '../components/PostFooter.astro';
import Toc from '../components/Toc.astro';
import { HTML_LANG, formatDate, isoDate, t, type Lang } from '../lib/i18n';
import { MIN_TAG_POSTS, getTagCounts, ogImagePath, postPath, tagPath, type Post } from '../lib/posts';
import '../styles/prose.css';

// A table of contents only pays off with enough sections
const MIN_TOC_HEADINGS = 3;

interface Props {
  lang: Lang;
  post: Post;
  posts: Post[];
  /** Path of the same post in the other language */
  alternate?: string;
}

const { lang, post, posts, alternate } = Astro.props;
const ui = t(lang);
const { Content, headings, remarkPluginFrontmatter } = await render(post);
const minutes = Number(remarkPluginFrontmatter.minutesRead ?? 1);
const tagCounts = getTagCounts(posts);
const toc = headings.filter(({ depth }) => depth === 2);
const url = new URL(postPath(lang, post.id), Astro.site).href;
const otherLang: Lang = lang === 'pt' ? 'en' : 'pt';
const showToc = toc.length >= MIN_TOC_HEADINGS;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  dateModified: post.data.date.toISOString(),
  inLanguage: HTML_LANG[lang],
  url,
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  image: new URL(ogImagePath(lang, post.id), Astro.site).href,
  keywords: post.data.tags.join(', '),
  author: { '@type': 'Person', name: 'Felipe Fialho', url: new URL('/', Astro.site).href },
};
---

<Base
  lang={lang}
  title={post.data.title}
  description={post.data.description}
  image={ogImagePath(lang, post.id)}
  type="article"
  alternate={alternate}
  publishedTime={post.data.date}
  tags={post.data.tags}
  jsonLd={jsonLd}
>
  <div class="progress" aria-hidden="true"></div>
  <article class="post" data-pagefind-body data-pagefind-meta={`date:${isoDate(post.data.date)}`}>
    <header class="post-header page-head split">
      <div>
        <h1 class="post-title" style={`view-transition-name: post-${post.id}`}>{post.data.title}</h1>
        <p class="lede">{post.data.description}</p>
        {
          post.data.tags.length > 0 && (
            <ul class="tags" aria-label="Tags">
              {post.data.tags.map((tag) => (
                <li>{(tagCounts.get(tag) ?? 0) >= MIN_TAG_POSTS ? <a href={tagPath(lang, tag)}>{tag}</a> : tag}</li>
              ))}
            </ul>
          )
        }
      </div>
      <div class="aside post-meta">
        <p>
          <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date, lang)}</time>
          <span>{ui.readingTime(minutes)}</span>
        </p>
        {
          alternate && (
            <p>
              <a href={alternate} hreflang={HTML_LANG[otherLang]} lang={HTML_LANG[otherLang]}>
                {ui.otherLang}
              </a>
            </p>
          )
        }
      </div>
    </header>

    <div class="post-body split">
      <div class="post-main">
        {showToc && <Toc headings={toc} lang={lang} variant="inline" />}

        <div class="prose">
          <Content />
        </div>

        <AdSlot kind="end" lang={lang} />
      </div>

      {showToc && <Toc headings={toc} lang={lang} variant="sidebar" />}
    </div>
  </article>

  <PostFooter lang={lang} post={post} posts={posts} />
  <AdsLoader />
</Base>

<style>
  .post-title {
    max-inline-size: 22ch;
    margin: 0;
    font-size: clamp(2.25rem, 1.4rem + 3.4vw, 4.5rem);
    font-stretch: 116%;
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.03em;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-4);
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
    color: var(--muted);
    font-family: var(--font-ui);
    font-size: var(--step--1);
    font-stretch: 110%;
    font-weight: 600;

    & li {
      display: inline-flex;
      align-items: center;
      min-block-size: 2.75rem;
    }
  }

  .post-meta {
    font-family: var(--font-ui);
    font-size: var(--step--1);
    line-height: 1.5;

    & p {
      margin: 0;
    }

    & time {
      display: block;
      color: var(--ink);
      font-weight: 650;
    }

    & span {
      color: var(--muted);
    }

    & a {
      display: inline-block;
      margin-block-start: var(--space-2);
      font-weight: 600;
    }

    @media (width >= 60rem) {
      padding-block-start: 0.9rem;
    }
  }

  .post-main {
    min-inline-size: 0;
    max-inline-size: var(--measure);
  }

  /*
   * Reading progress: a scroll-driven div, no JS. A <progress> cannot take its value
   * from CSS, so it would expose a stale value to assistive tech.
   * Kept under reduced motion: it tracks the reader's own scroll 1:1, like a scrollbar.
   */
  .progress {
    display: none;
  }

  @supports (animation-timeline: scroll()) {
    .progress {
      position: fixed;
      inset: 0 0 auto;
      z-index: 5;
      display: block;
      block-size: 4px;
      background: var(--link);
      transform-origin: 0 50%;
      animation-name: progress;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: scroll(root);
    }
  }

  @keyframes progress {
    from {
      transform: scaleX(0);
    }

    to {
      transform: scaleX(1);
    }
  }
</style>
