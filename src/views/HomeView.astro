---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { SITE_NAME, formatDate, isoDate, localePath, t, type Lang } from '../lib/i18n';
import { getLabProjects } from '../lib/lab';
import { getPosts, postPath } from '../lib/posts';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = t(lang);
const posts = (await getPosts(lang)).slice(0, 6);
const lab = (await getLabProjects()).slice(0, 3);
const home = await getEntry('pages', `${lang}/home`);
const { Content } = home ? await render(home) : { Content: null };

---

<Base lang={lang} title={SITE_NAME} description={ui.homeDescription} alternate={localePath(lang === 'pt' ? 'en' : 'pt', '/')}>
  <section class="hero">
    <h1>{SITE_NAME}</h1>
    <p class="role">
      <strong>{ui.role}</strong>
      <span>{ui.roleFocus}</span>
    </p>
    {Content && <div class="intro reading"><Content /></div>}
    <p><a class="text-link" href={localePath(lang, '/hi/')}>{ui.moreAbout}</a></p>
  </section>

  <section aria-labelledby="latest">
    <h2 id="latest" class="section-title">{ui.latest}</h2>
    <ol class="post-list">
      {
        posts.map((post) => (
          <li class="post-item">
            <h3>
              <a href={postPath(lang, post.id)} style={`view-transition-name: post-${post.id}`}>
                {post.data.title}
              </a>
            </h3>
            <p class="description">{post.data.description}</p>
            <p class="meta">
              <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date, lang)}</time>
            </p>
          </li>
        ))
      }
    </ol>
    <p><a class="text-link" href={localePath(lang, '/blog/')}>{ui.allPosts}</a></p>
  </section>

  <section aria-labelledby="lab">
    <h2 id="lab" class="section-title">{ui.fromLab}</h2>
    <ul class="lab-list">
      {
        lab.map(({ data }) => (
          <li>
            <a href={data.url}>{data.title}</a>
            <span>{data.description[lang]}</span>
          </li>
        ))
      }
    </ul>
    <p><a class="text-link" href={localePath(lang, '/lab/')}>{ui.allLab}</a></p>
  </section>
</Base>

<style>
  .hero {
    padding-block: var(--space-4) var(--space-3);

    & h1 {
      margin: 0 0 var(--space-2);
      font-size: var(--step-4);
      font-stretch: 118%;
      font-weight: 800;
      line-height: 1;
      letter-spacing: -0.03em;
    }
  }

  .role {
    display: grid;
    gap: var(--space-1);
    margin: 0 0 var(--space-4);
    font-family: var(--font-ui);
    font-size: var(--step-1);

    & span {
      color: var(--muted);
      font-size: var(--step-0);
    }
  }

  .intro :global(p) {
    margin-block: 0 var(--space-3);
  }

  .lab-list {
    display: grid;
    gap: var(--space-3);
    margin: 0 0 var(--space-4);
    padding: 0;
    list-style: none;
    max-inline-size: var(--measure);

    & li {
      display: grid;
      gap: var(--space-1);
    }

    & a {
      font-family: var(--font-ui);
      font-size: var(--step-1);
      font-weight: 600;
    }

    & span {
      color: var(--muted);
    }
  }
</style>
