---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { SITE_NAME, formatDate, isoDate, localePath, t, type Lang } from '../lib/i18n';
import { getPosts, postPath } from '../lib/posts';
import { homeJsonLd } from '../lib/seo';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = t(lang);
const posts = (await getPosts(lang)).slice(0, 6);
const home = await getEntry('pages', `${lang}/home`);
const { Content } = home ? await render(home) : { Content: null };
const contacts = [
  { label: ui.linkedin, href: 'https://www.linkedin.com/in/felipefialho/' },
  { label: ui.github, href: 'https://github.com/felipefialho' },
  { label: ui.email, href: 'mailto:hi@felipefialho.com' },
  { label: ui.youtube, href: 'https://www.youtube.com/@felipefialhodev' },
];
const jsonLd = homeJsonLd({ lang, path: localePath(lang, '/'), title: SITE_NAME, description: ui.homeDescription });
---

<Base
  lang={lang}
  title={ui.homeTitle}
  description={ui.homeDescription}
  alternate={localePath(lang === 'pt' ? 'en' : 'pt', '/')}
  jsonLd={jsonLd}
>
  <section class="hero">
    <h1>{SITE_NAME}</h1>
    <p class="role">
      <strong>{ui.role}</strong>
      <span>{ui.roleFocus}</span>
    </p>
    {Content && <div class="intro reading"><Content /></div>}
    <ul class="contact" aria-label={ui.contact}>
      {contacts.map(({ label, href }) => <li><a href={href}>{label}</a></li>)}
    </ul>
    <p><a class="text-link" href={localePath(lang, '/hi/')}>{ui.moreAbout}</a></p>
  </section>

  <section aria-labelledby="latest">
    <h2 id="latest" class="section-title">{ui.latest}</h2>
    <ol class="post-list">
      {
        posts.map((post) => (
          <li class="post-item">
            <h3>
              <a href={postPath(lang, post.id)} style={`view-transition-name: post-${post.id}`}>
                {post.data.title}
              </a>
            </h3>
            <p class="description">{post.data.description}</p>
            <p class="meta">
              <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date, lang)}</time>
            </p>
          </li>
        ))
      }
    </ol>
    <p><a class="text-link" href={localePath(lang, '/blog/')}>{ui.allPosts}</a></p>
  </section>
</Base>

<style>
  .hero {
    padding-block: var(--space-4) var(--space-3);

    & h1 {
      margin: 0 0 var(--space-2);
      font-size: var(--step-4);
      font-stretch: 118%;
      font-weight: 800;
      line-height: 1;
      letter-spacing: -0.03em;
    }
  }

  .role {
    display: grid;
    gap: var(--space-1);
    margin: 0 0 var(--space-4);
    font-family: var(--font-ui);
    font-size: var(--step-1);

    & span {
      color: var(--muted);
      font-size: var(--step-0);
    }
  }

  .intro :global(p) {
    margin-block: 0 var(--space-3);
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-4);
    margin: 0 0 var(--space-2);
    padding: 0;
    list-style: none;

    & a {
      display: inline-flex;
      align-items: center;
      min-block-size: 2.75rem;
      font-family: var(--font-ui);
      font-size: var(--step-0);
      font-weight: 600;
    }
  }
</style>
