---
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import photo from '../assets/images/felipe-fialho.jpg';
import Base from '../layouts/Base.astro';
import { formatDate, localePath, t, type Lang } from '../lib/i18n';
import { profilePageJsonLd } from '../lib/seo';
import '../styles/prose.css';

interface Props {
  lang: Lang;
  /** Entry name inside content/pages/<lang>/ */
  page: 'hi' | 'policies';
}

const { lang, page } = Astro.props;
const entry = await getEntry('pages', `${lang}/${page}`);
if (!entry) throw new Error(`Missing content/pages/${lang}/${page}.md`);
const { Content } = await render(entry);
const updated = entry.data.updated;
const otherLang: Lang = lang === 'pt' ? 'en' : 'pt';
const description = entry.data.description ?? entry.data.title;
const jsonLd =
  page === 'hi'
    ? profilePageJsonLd({ lang, path: localePath(lang, '/hi/'), title: entry.data.title, description, updated })
    : undefined;
---

<Base
  lang={lang}
  title={entry.data.title}
  description={description}
  alternate={localePath(otherLang, `/${page}/`)}
  jsonLd={jsonLd}
>
  <header class="page-head split">
    <div>
      <h1 class="page-title">{entry.data.title}</h1>
    </div>
    {
      updated && (
        <p class="meta aside">
          {t(lang).lastUpdated} {formatDate(updated, lang)}
        </p>
      )
    }
  </header>
  <div class="split">
    <div class="prose">
      <Content />
    </div>
    {
      page === 'hi' && (
        <div class="aside">
          <div class="portrait duotone">
            <Image
              src={photo}
              alt={t(lang).photoAlt}
              width={240}
              height={300}
              fit="cover"
              densities={[1, 2]}
              loading="eager"
            />
          </div>
        </div>
      )
    }
  </div>
</Base>

<style>
  .portrait {
    inline-size: min(100%, 15rem);
    aspect-ratio: 4 / 5;

    @media (width >= 60rem) {
      position: sticky;
      inset-block-start: var(--space-5);
    }
  }

  /* On a phone the portrait comes before the text it illustrates */
  .aside:has(.portrait) {
    order: -1;
  }

  .page-head .meta {
    @media (width >= 60rem) {
      padding-block-start: 1rem;
    }
  }
</style>
