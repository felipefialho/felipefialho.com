---
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import photo from '../assets/images/felipe-fialho.jpg';
import Base from '../layouts/Base.astro';
import { formatDate, localePath, t, type Lang } from '../lib/i18n';
import { profilePageJsonLd } from '../lib/seo';
import '../styles/prose.css';

interface Props {
  lang: Lang;
  /** Entry name inside content/pages/<lang>/ */
  page: 'hi' | 'policies';
}

const { lang, page } = Astro.props;
const entry = await getEntry('pages', `${lang}/${page}`);
if (!entry) throw new Error(`Missing content/pages/${lang}/${page}.md`);
const { Content } = await render(entry);
const updated = entry.data.updated;
const otherLang: Lang = lang === 'pt' ? 'en' : 'pt';
const description = entry.data.description ?? entry.data.title;
const jsonLd =
  page === 'hi'
    ? profilePageJsonLd({ lang, path: localePath(lang, '/hi/'), title: entry.data.title, description, updated })
    : undefined;
---

<Base
  lang={lang}
  title={entry.data.title}
  description={description}
  alternate={localePath(otherLang, `/${page}/`)}
  jsonLd={jsonLd}
>
  <h1 class="page-title">{entry.data.title}</h1>
  {
    page === 'hi' && (
      <Image
        src={photo}
        alt={t(lang).photoAlt}
        widths={[320, 480, 640, 800]}
        sizes="(min-width: 48rem) 22rem, 100vw"
        loading="eager"
        class="portrait"
      />
    )
  }
  {
    updated && (
      <p class="meta">
        {t(lang).lastUpdated} {formatDate(updated, lang)}
      </p>
    )
  }
  <div class="prose">
    <Content />
  </div>
</Base>

<style>
  .portrait {
    inline-size: min(100%, 22rem);
    block-size: auto;
    margin-block-end: var(--space-5);
    border-radius: var(--radius);
    background: var(--wash);
  }

  .meta {
    margin-block: calc(-1 * var(--space-3)) var(--space-5);
  }
</style>
