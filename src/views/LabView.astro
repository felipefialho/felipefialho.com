---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { getLabProjects } from '../lib/lab';
import { localePath, t, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const projects = await getLabProjects();
const ui = t(lang);
---

<Base lang={lang} title={ui.lab} description={ui.labDescription} alternate={localePath(lang === 'pt' ? 'en' : 'pt', '/lab/')}>
  <h1 class="page-title">{ui.lab}</h1>
  <p class="lede reading">{ui.labLede}</p>
  <ol class="projects">
    {
      projects.map(({ data }, index) => (
        <li class="project">
          <Image
            src={data.image}
            alt={ui.labShot(data.title)}
            width={480}
            widths={[320, 480, 640, 960]}
            sizes="(min-width: 48rem) 20rem, 100vw"
            loading={index === 0 ? 'eager' : 'lazy'}
            class="shot"
          />
          <div>
            <h2>
              <a href={data.url}>{data.title}</a>
            </h2>
            <p class="meta">{data.year}</p>
            <p>{data.description[lang]}</p>
            <p class="links">
              {data.repo === data.url ? (
                <a class="text-link" href={data.url}>
                  {ui.codeOnGithub}
                </a>
              ) : (
                <>
                  <a class="text-link" href={data.url}>
                    {ui.viewProject}
                  </a>
                  {data.repo && (
                    <a class="text-link" href={data.repo}>
                      {ui.code}
                    </a>
                  )}
                </>
              )}
            </p>
          </div>
        </li>
      ))
    }
  </ol>
</Base>

<style>
  .projects {
    display: grid;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project {
    display: grid;
    gap: var(--space-4);
    align-items: start;

    @media (width >= 48rem) {
      grid-template-columns: minmax(0, 20rem) minmax(0, var(--measure));
    }

    & h2 {
      margin: 0 0 var(--space-1);
      font-size: var(--step-2);
    }

    & p {
      margin-block: 0 var(--space-2);
    }
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
  }

  .shot {
    inline-size: 100%;
    block-size: auto;
    border-radius: var(--radius);
    background: var(--wash);
  }
</style>
