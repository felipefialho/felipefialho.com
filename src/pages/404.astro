---
import Cartman from '../components/Cartman.astro';
import Base from '../layouts/Base.astro';
import { t } from '../lib/i18n';
import { getPosts, postPath } from '../lib/posts';

const ui = t('pt').notFound;
const en = t('en').notFound;

// Compact catalog for the "did you mean" hint, both languages: the path decides which one is used
const catalog = (
  await Promise.all(
    (['pt', 'en'] as const).map(async (lang) =>
      (await getPosts(lang)).map(({ id, data }) => ({ slug: id, title: data.title, lang, href: postPath(lang, id) })),
    ),
  )
).flat();
const json = (value: unknown) => JSON.stringify(value).replaceAll('<', '\\u003c');
---

<Base lang="pt" title={ui.title} description={ui.description} noindex>
  <h1 class="visually-hidden" data-i18n="title">{ui.title}</h1>
  <div class="grid">
    <div class="left">
      <div class="code" aria-hidden="true">404</div>
      <div class="term">
        <div class="bar" aria-hidden="true"><span></span><span></span><span></span></div>
        <div class="body">
          <div><span class="p">$</span> cd <span data-path data-testid="requested-path">/blog/o-post-que-voce-procurou</span></div>
          <div class="warm" data-i18n="cdError">{ui.cdError}</div>
          <div><span class="p">$</span> ls ~/</div>
          <div class="out" data-i18n="ls">{ui.ls}</div>
          <div class="log" role="log" data-log></div>
          <div><span class="p">$</span> <span class="caret p">_</span></div>
        </div>
      </div>
      <div class="try" hidden data-actions>
        <span data-i18n="try">{ui.try}</span>
        <button type="button" data-cmd="blog">cd blog</button>
        <button type="button" data-cmd="labs">cd labs</button>
        <button type="button" data-cmd="sudo">sudo</button>
        <button type="button" data-cmd="cartman" class="warm">cartman</button>
      </div>
    </div>
    <div class="right">
      <div class="bubble-slot"><p class="bubble" data-bubble data-testid="cartman-bubble" hidden aria-hidden="true"></p></div>
      <Cartman data-cartman data-testid="cartman" />
      <span class="caption">eric.css · 2012</span>
    </div>
  </div>
  <p class="foot">
    <span data-i18n="footer">{ui.footer}</span>
    <a href="/" data-i18n="back" data-home>{ui.back}</a>
  </p>

  <script type="application/json" id="not-found-data" set:html={json({ pt: ui, en, posts: catalog })} />
  <script>
    import { suggestPost, type PostSuggestion } from '../lib/suggest-post';

    interface Strings {
      title: string;
      description: string;
      [key: string]: string;
    }

    const data = JSON.parse(document.getElementById('not-found-data')!.textContent!) as {
      pt: Strings;
      en: Strings;
      posts: PostSuggestion[];
    };
    const pathname = location.pathname;
    const lang = pathname === '/en' || pathname.startsWith('/en/') ? 'en' : 'pt';
    const ui = data[lang];
    const MAX_COMMANDS = 6;

    if (lang === 'en') {
      document.documentElement.lang = 'en';
      document.title = document.title.replace(data.pt.title, ui.title);
      document.querySelector('meta[name="description"]')?.setAttribute('content', ui.description);
      for (const node of document.querySelectorAll<HTMLElement>('[data-i18n]')) {
        node.textContent = ui[node.dataset.i18n!] ?? node.textContent;
      }
      document.querySelector<HTMLAnchorElement>('[data-home]')!.href = '/en/';
    }

    let shown = pathname;
    try {
      shown = decodeURIComponent(pathname);
    } catch {
      // Malformed escape: show the raw path
    }
    document.querySelector('[data-path]')!.textContent = shown;

    const log = document.querySelector<HTMLElement>('[data-log]')!;
    const bubble = document.querySelector<HTMLElement>('[data-bubble]')!;
    const cartman = document.querySelector<HTMLElement>('[data-cartman]')!;
    const home = lang === 'en' ? '/en' : '';

    const line = (...children: (Node | string)[]) => {
      const row = document.createElement('div');
      row.append(...children);
      return row;
    };
    const prompt = (command: string) => {
      const mark = document.createElement('span');
      mark.className = 'p';
      mark.textContent = '$';
      return line(mark, ` ${command}`);
    };
    const output = (content: string | (Node | string)[], tone: 'out' | 'warm') => {
      const row = line(...[content].flat());
      row.className = tone;
      return row;
    };
    const link = (href: string, text: string) => {
      const anchor = document.createElement('a');
      anchor.href = href;
      anchor.textContent = text;
      return anchor;
    };

    const suggestion = suggestPost(
      pathname,
      data.posts.filter(({ lang: postLang }) => postLang === lang),
    );
    if (suggestion) {
      log.append(line(`${ui.dym} `, link(suggestion.href, suggestion.title), '?'));
    }

    const commands: Record<string, () => { lines: HTMLElement[]; bubble: string }> = {
      blog: () => ({
        lines: [prompt('cd blog'), output([`${ui.cmdBlog} `, link(`${home}/blog/`, ui.goBlog)], 'out')],
        bubble: ui.bubbleBlog,
      }),
      labs: () => ({
        lines: [prompt('cd labs'), output([`${ui.cmdLabs} `, link(`${home}/lab/`, ui.goLabs)], 'out')],
        bubble: ui.bubbleLabs,
      }),
      sudo: () => ({ lines: [prompt(ui.cmdSudo), output(ui.outSudo, 'warm')], bubble: ui.bubbleSudo }),
      cartman: () => ({ lines: [prompt('cartman'), output(ui.outCartman, 'warm')], bubble: ui.bubbleCartman }),
    };

    const walk = (on: boolean) => {
      cartman.classList.remove('is-walking');
      if (!on) return;
      // Restart the animation when the button is pressed again
      void cartman.offsetWidth;
      cartman.classList.add('is-walking');
    };

    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-cmd]')) {
      button.addEventListener('click', () => {
        const name = button.dataset.cmd!;
        const { lines, bubble: text } = commands[name]();
        log.append(...lines);
        while (log.children.length > MAX_COMMANDS * 2) log.firstElementChild!.remove();
        bubble.textContent = text;
        bubble.hidden = false;
        walk(name === 'cartman');
      });
    }
    document.querySelector<HTMLElement>('[data-actions]')!.hidden = false;
  </script>
</Base>

<style>
  .grid {
    display: grid;
    gap: var(--space-6) clamp(2rem, 5.556vw, 5rem);
    align-items: center;

    @media (width >= 60rem) {
      grid-template-columns: minmax(0, 1fr) minmax(0, 26.25rem);
    }
  }

  .left {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    min-inline-size: 0;
  }

  .code {
    color: var(--line);
    font-family: var(--font-code);
    font-size: clamp(6rem, 12.5vw, 11.25rem);
    font-weight: 600;
    line-height: 0.85;
    letter-spacing: -0.06em;
    user-select: none;
  }

  .term {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 0.875rem;
    background: var(--sunken);
  }

  .bar {
    display: flex;
    gap: 0.375rem;
    padding: 0.75rem 1rem;
    border-block-end: 1px solid var(--line);

    & span {
      inline-size: 0.625rem;
      block-size: 0.625rem;
      border-radius: 50%;
      background: var(--line);
    }
  }

  .body {
    display: flex;
    flex-direction: column;
    padding: clamp(1rem, 1.667vw, 1.5rem);
    color: var(--ink);
    font-family: var(--font-code);
    font-size: clamp(0.875rem, 0.833rem + 0.185vw, 1rem);
    line-height: 1.8;
    overflow-wrap: anywhere;
    white-space: pre-wrap;
  }

  .p {
    color: var(--accent);
  }

  .warm {
    color: var(--warm);
  }

  .out {
    color: var(--soft);
  }

  .caret {
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .try {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.625rem;
    color: var(--muted);
    font-family: var(--font-code);
    font-size: var(--step--1);

    &[hidden] {
      display: none;
    }

    & button {
      min-block-size: 2.75rem;
      padding: 0.5rem 0.875rem;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--surface);
      color: var(--ink);
      font: inherit;
      cursor: pointer;
      transition:
        background 0.2s ease,
        color 0.2s ease;

      &:hover {
        background: var(--accent);
        color: var(--on-accent);
      }

      &.warm {
        color: var(--warm);

        &:hover {
          color: var(--on-accent);
        }
      }
    }
  }

  .right {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    overflow: hidden;
    padding-block: var(--space-5);
  }

  .bubble-slot {
    display: flex;
    align-items: flex-end;
    block-size: 3.5rem;
  }

  .bubble {
    margin: 0;
    max-inline-size: 20rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: 1rem 1rem 1rem 0.25rem;
    background: var(--surface);
    color: var(--ink);
    font-family: var(--font-code);
    font-size: 0.9375rem;
    line-height: 1.5;

    &[hidden] {
      display: none;
    }
  }

  .caption {
    color: var(--faint);
    font-family: var(--font-code);
    font-size: var(--step--2);
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    margin: var(--space-6) 0 0;
    color: var(--muted);
    font-family: var(--font-code);
    font-size: 0.8125rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .caret {
      animation: none;
    }
  }
</style>
