---
import Base from '../layouts/Base.astro';
import { getPosts, postPath } from '../lib/posts';

const latest = (await getPosts('pt')).slice(0, 5);
---

<Base lang="pt" title="Página não encontrada" description="Essa página não existe ou mudou de endereço." noindex>
  <h1 class="page-title">Essa página não existe</h1>
  <p class="lede reading">
    O endereço pode ter mudado. Veja <a href="/blog/">todos os posts</a> ou use a busca no topo.
    <span lang="en">Looking for English content? Head to <a href="/en/">the English home</a>.</span>
  </p>
  <h2 class="section-title">Posts recentes</h2>
  <ul class="post-list">
    {
      latest.map((post) => (
        <li class="post-item">
          <h3>
            <a href={postPath('pt', post.id)}>{post.data.title}</a>
          </h3>
        </li>
      ))
    }
  </ul>
</Base>
