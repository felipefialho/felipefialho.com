---
import type { GetStaticPaths } from 'astro';
import { getPosts, getTranslationMap, postPath, type Post } from '../../../lib/posts';
import PostView from '../../../views/PostView.astro';

export const getStaticPaths = (async () => {
  const posts = await getPosts('en');
  const { enToPt } = await getTranslationMap();
  return posts.map((post) => {
    const original = enToPt.get(post.id);
    return {
      params: { slug: post.id },
      props: { post, posts, alternate: original ? postPath('pt', original) : undefined },
    };
  });
}) satisfies GetStaticPaths;

interface Props {
  post: Post;
  posts: Post[];
  alternate?: string;
}

const { post, posts, alternate } = Astro.props;
---

<PostView lang="en" post={post} posts={posts} alternate={alternate} />
