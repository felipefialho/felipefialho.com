---
import type { GetStaticPaths } from 'astro';
import { tagStaticPaths, type Post } from '../../../../lib/posts';
import ArchiveView from '../../../../views/ArchiveView.astro';

export const getStaticPaths = (() => tagStaticPaths('en')) satisfies GetStaticPaths;

interface Props {
  tag: string;
  posts: Post[];
}

const { tag, posts } = Astro.props;
---

<ArchiveView lang="en" posts={posts} tag={tag} />
