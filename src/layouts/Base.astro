---
import { Font } from 'astro:assets';
import ConsentBanner from '../components/ConsentBanner.astro';
import ConsentHead from '../components/ConsentHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SearchDialog from '../components/SearchDialog.astro';
import { HTML_LANG, OG_LOCALE, localePath, t, type Lang } from '../lib/i18n';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/layout.css';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Site path of the social card, e.g. /og/slug.jpg */
  image?: string;
  type?: 'website' | 'article';
  /** Same page in the other language, when it exists */
  alternate?: string;
  publishedTime?: Date;
  tags?: string[];
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
}

const {
  lang,
  title,
  description,
  image = localePath(lang, '/og/default.jpg'),
  type = 'website',
  alternate,
  publishedTime,
  tags = [],
  noindex = false,
  jsonLd,
} = Astro.props;

const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).href;
const imageUrl = new URL(image, site).href;
const otherLang: Lang = lang === 'pt' ? 'en' : 'pt';
const fullTitle = title === 'Felipe Fialho' ? title : `${title} | Felipe Fialho`;
const feed = localePath(lang, '/feed.xml');
const speculationRules = { prefetch: [{ where: { href_matches: '/*' }, eagerness: 'moderate' }] };
---

<!doctype html>
<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ConsentHead />
    <script is:inline>
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {
        // Storage blocked: fall back to the OS preference
      }
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {alternate && <link rel="alternate" hreflang={HTML_LANG[lang]} href={canonical} />}
    {alternate && <link rel="alternate" hreflang={HTML_LANG[otherLang]} href={new URL(alternate, site).href} />}
    <link rel="alternate" type="application/rss+xml" title="Felipe Fialho" href={feed} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#fdfdfc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f0f1a" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Felipe Fialho" />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@felipefialho_" />
    <meta name="twitter:creator" content="@felipefialho_" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <Font cssVariable="--font-mona-sans" preload />
    <Font cssVariable="--font-newsreader" preload={[{ style: 'normal' }]} />
    <script type="speculationrules" is:inline set:html={JSON.stringify(speculationRules)} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#content">{t(lang).skip}</a>
    <Header lang={lang} alternate={alternate} />
    <main id="content" class="page main">
      <slot />
    </main>
    <Footer lang={lang} />
    <SearchDialog lang={lang} />
    <ConsentBanner lang={lang} />
    <slot name="end" />
  </body>
</html>
